# Gameserver Management Commands
# Usage: just <command>

# List all game services and their status
status:
    #!/usr/bin/env bash
    echo "=== Game Server Services ==="
    echo ""

    echo "Steam Download Services:"
    sudo systemctl list-units 'steam@*' --no-legend --no-pager | awk '{print "  " $1 " - " $3}' || echo "  (no steam services found)"
    echo ""

    echo "Game Services:"
    if [[ -d /etc/gameserver/services ]]; then
        for json_file in /etc/gameserver/services/*.json; do
            if [[ -f "$json_file" ]]; then
                game_id=$(jq -r '.id' "$json_file")
                game_name=$(jq -r '.name' "$json_file")
                unit_name=$(jq -r '.unit_name' "$json_file")
                ports=$(jq -r '.ports | join(",")' "$json_file")

                status=$(sudo systemctl is-active "$unit_name" 2>/dev/null || echo "inactive")

                echo "  $game_id ($game_name) - $status"
                if [[ "$ports" != "null" && "$ports" != "" ]]; then
                    echo "    Ports: $ports"
                fi
            fi
        done
    else
        echo "  (no games configured)"
    fi

    echo ""
    echo "Available commands:"
    echo "  just status              - Show this status"
    echo "  just list                - List available games"
    echo "  just start <game>        - Start a game service"
    echo "  just stop <game>         - Stop a game service"
    echo "  just restart <game>      - Restart a game service"
    echo "  just clean <game>        - Clean/uninstall a game (stop, remove files)"
    echo "  just logs <game>         - Show recent logs"
    echo "  just update <game>       - Update game files and restart"
    echo "  just info <game>         - Show game information"
    echo ""
    echo "Note: Games run as transient systemd units (no persistent auto-start)"
    echo ""
    available_games=$(find /etc/gameserver/services -name "*.json" 2>/dev/null | xargs -I {} jq -r '.id' {} | tr '\n' ' ' || echo "none")
    echo "Available games: $available_games"

# List available games with details
list:
    #!/usr/bin/env bash
    echo "=== Available Games ==="
    echo ""
    if [[ -d /etc/gameserver/services ]]; then
        for json_file in /etc/gameserver/services/*.json; do
            if [[ -f "$json_file" ]]; then
                echo "$(jq -r '.id' "$json_file"): $(jq -r '.name' "$json_file")"
                echo "  Service: $(jq -r '.service_name' "$json_file")"
                echo "  Steam App: $(jq -r '.steam_app // "N/A"' "$json_file")"
                echo "  Ports: $(jq -r '.ports | join(",") // "N/A"' "$json_file")"
                echo "  User: $(jq -r '.user // "N/A"' "$json_file")"
                echo "  Description: $(jq -r '.description // "N/A"' "$json_file")"
                echo ""
            fi
        done
    else
        echo "No games configured."
    fi

# Show detailed information about a specific game
info game:
    #!/usr/bin/env bash
    set -euo pipefail
    json_file="/etc/gameserver/services/{{game}}.json"
    if [[ ! -f "$json_file" ]]; then
        echo "Game '{{game}}' not found."
        echo "Available games:"
        find /etc/gameserver/services -name "*.json" 2>/dev/null | xargs -I {} jq -r '.id' {} || echo "  none"
        exit 1
    fi

    echo "=== $(jq -r '.name' "$json_file") Information ==="
    echo ""
    echo "Game ID: {{game}}"
    echo "Service Name: $(jq -r '.service_name' "$json_file")"
    echo "Steam App: $(jq -r '.steam_app // "N/A"' "$json_file")"
    echo "Game Directory: $(jq -r '.game_dir // "N/A"' "$json_file")"
    echo "Ports: $(jq -r '.ports | join(",") // "N/A"' "$json_file")"
    echo "Config File: $(jq -r '.config_file // "N/A"' "$json_file")"
    echo "Log Directory: $(jq -r '.log_dir // "N/A"' "$json_file")"
    echo "Run User: $(jq -r '.user // "N/A"' "$json_file")"
    echo "Group: $(jq -r '.group // "N/A"' "$json_file")"
    echo "Description: $(jq -r '.description // "N/A"' "$json_file")"
    echo ""

    # Show current status
    service_name=$(jq -r '.service_name' "$json_file")
    status=$(sudo systemctl is-active "$service_name" 2>/dev/null || echo "not-found")
    enabled=$(sudo systemctl is-enabled "$service_name" 2>/dev/null || echo "disabled")
    echo "Current Status: $status ($enabled)"

    # Show port status if ports are defined
    ports=$(jq -r '.ports[]? // empty' "$json_file")
    if [[ -n "$ports" ]]; then
        echo ""
        echo "Port Status:"
        while IFS= read -r port; do
            if ss -tuln | grep -q ":$port "; then
                echo "  $port: LISTENING"
            else
                echo "  $port: closed"
            fi
        done <<< "$ports"
    fi

# Start a game service (with dependencies)
start game:
    #!/usr/bin/env bash
    set -euo pipefail

    json_file="/etc/gameserver/services/{{game}}.json"
    if [[ ! -f "$json_file" ]]; then
        echo "Game '{{game}}' not found."
        echo "Available games:"
        find /etc/gameserver/services -name "*.json" 2>/dev/null | xargs -I {} jq -r '.id' {} || echo "  none"
        exit 1
    fi

    game_name=$(jq -r '.name' "$json_file")
    unit_name=$(jq -r '.unit_name' "$json_file")
    steam_app=$(jq -r '.steam_app // empty' "$json_file")
    executable=$(jq -r '.executable' "$json_file")
    user=$(jq -r '.user' "$json_file")
    group=$(jq -r '.group // "game"' "$json_file")
    working_dir=$(jq -r '.working_directory // empty' "$json_file")

    echo "Starting $game_name..."

    # Check if already running
    if sudo systemctl is-active --quiet "$unit_name" 2>/dev/null; then
        echo "$game_name is already running!"
        exit 1
    fi

    # Handle steam dependency if specified
    if [[ -n "$steam_app" && "$steam_app" != "null" ]]; then
        marker_file="/opt/steam-app-${steam_app}/.steamcmd-completed"
        if [[ ! -f "$marker_file" ]]; then
            echo "Steam files not ready, downloading first..."
            sudo systemctl start "steam@${steam_app}.service"
            echo "Waiting for steam download to complete..."
            while ! sudo systemctl is-active --quiet "steam@${steam_app}.service" && ! sudo systemctl is-failed --quiet "steam@${steam_app}.service"; do
                sleep 2
            done
            if sudo systemctl is-failed --quiet "steam@${steam_app}.service"; then
                echo "Steam download failed!"
                sudo journalctl -u "steam@${steam_app}.service" --no-pager -n 20
                exit 1
            fi
        fi
    fi

    # Build systemd-run command
    cmd=(
        sudo systemd-run
        --unit="$unit_name"
        --uid="$user"
        --gid="$group"
        --property=Restart=always
        --property=RestartSec=5
        --property=Nice=-5
        --property=UMask=0002
        --property=PrivateTmp=yes
    )

    # Add working directory if specified
    if [[ -n "$working_dir" && "$working_dir" != "null" ]]; then
        cmd+=(--working-directory="$working_dir")
    fi

    # Add environment variables
    env_vars=$(jq -r '.environment // {} | to_entries[] | "--setenv=\(.key)=\(.value)"' "$json_file")
    if [[ -n "$env_vars" ]]; then
        while IFS= read -r env_var; do
            cmd+=("$env_var")
        done <<< "$env_vars"
    fi

    # Add executable and arguments
    cmd+=("$executable")

    # Add arguments
    args=$(jq -r '.args[]? // empty' "$json_file")
    if [[ -n "$args" ]]; then
        while IFS= read -r arg; do
            cmd+=("$arg")
        done <<< "$args"
    fi

    # Execute the command
    "${cmd[@]}"
    echo "$game_name started as systemd unit: $unit_name"

# Stop a game service
stop game:
    #!/usr/bin/env bash
    set -euo pipefail

    json_file="/etc/gameserver/services/{{game}}.json"
    if [[ ! -f "$json_file" ]]; then
        echo "Game '{{game}}' not found."
        exit 1
    fi

    game_name=$(jq -r '.name' "$json_file")
    unit_name=$(jq -r '.unit_name' "$json_file")

    echo "Stopping $game_name..."
    sudo systemctl stop "$unit_name"

# Restart a game service
restart game:
    just stop {{game}}
    sleep 2
    just start {{game}}

# Show recent logs for a game
logs game *args="--no-pager -n 50":
    #!/usr/bin/env bash
    set -euo pipefail

    if [[ "{{game}}" == "steam" ]]; then
        echo "=== Steam Download Logs ==="
        sudo journalctl -u 'steam@*' {{args}}
    else
        json_file="/etc/gameserver/services/{{game}}.json"
        if [[ ! -f "$json_file" ]]; then
            echo "Game '{{game}}' not found."
            echo "Use 'just logs steam' for Steam download logs."
            exit 1
        fi

        game_name=$(jq -r '.name' "$json_file")
        unit_name=$(jq -r '.unit_name' "$json_file")

        echo "=== $game_name Logs ==="
        sudo journalctl -u "$unit_name" {{args}}
    fi

# Update game files and restart
update game:
    #!/usr/bin/env bash
    set -euo pipefail

    json_file="/etc/gameserver/services/{{game}}.json"
    if [[ ! -f "$json_file" ]]; then
        echo "Game '{{game}}' not found."
        exit 1
    fi

    game_name=$(jq -r '.name' "$json_file")
    unit_name=$(jq -r '.unit_name' "$json_file")
    steam_app=$(jq -r '.steam_app // empty' "$json_file")

    echo "Updating $game_name..."

    # Stop the game service
    sudo systemctl stop "$unit_name" || true

    # Update steam files if needed
    if [[ -n "$steam_app" && "$steam_app" != "null" ]]; then
        echo "Downloading latest game files..."
        sudo systemctl start "steam@${steam_app}.service"
        echo "Waiting for download to complete..."
        while ! sudo systemctl is-active --quiet "steam@${steam_app}.service" && ! sudo systemctl is-failed --quiet "steam@${steam_app}.service"; do
            sleep 2
        done
        if sudo systemctl is-failed --quiet "steam@${steam_app}.service"; then
            echo "Steam download failed!"
            sudo journalctl -u "steam@${steam_app}.service" --no-pager -n 20
            exit 1
        fi
    fi

    echo "Starting updated server..."
    just start {{game}}

# Show game server ports and network status
network:
    #!/usr/bin/env bash
    echo "=== Network Status ==="
    echo ""

    # Show status for each configured game
    if [[ -d /etc/gameserver/services ]]; then
        for json_file in /etc/gameserver/services/*.json; do
            if [[ -f "$json_file" ]]; then
                game_id=$(jq -r '.id' "$json_file")
                game_name=$(jq -r '.name' "$json_file")
                unit_name=$(jq -r '.unit_name' "$json_file")
                status=$(sudo systemctl is-active "$unit_name" 2>/dev/null || echo "inactive")

                echo "$game_name ($game_id) - $status:"
                ports=$(jq -r '.ports[]? // empty' "$json_file")
                if [[ -n "$ports" ]]; then
                    while IFS= read -r port; do
                        if ss -tuln | grep -q ":$port "; then
                            echo "  Port $port: LISTENING"
                        else
                            echo "  Port $port: closed"
                        fi
                    done <<< "$ports"
                else
                    echo "  No ports configured"
                fi
                echo ""
            fi
        done
    fi

    echo "All listening ports in game range (26000-28000):"
    ss -tuln | grep -E ":(26[0-9][0-9][0-9]|27[0-9][0-9][0-9])" | sed 's/^/  /' || echo "  No game ports active"

# Clean/uninstall a game (stop, disable, remove files)
clean game *options="":
    #!/usr/bin/env bash
    set -euo pipefail

    json_file="/etc/gameserver/services/{{game}}.json"
    if [[ ! -f "$json_file" ]]; then
        echo "Game '{{game}}' not found."
        exit 1
    fi

    game_name=$(jq -r '.name' "$json_file")
    unit_name=$(jq -r '.unit_name' "$json_file")
    steam_app=$(jq -r '.steam_app // empty' "$json_file")
    game_dir=$(jq -r '.game_dir // empty' "$json_file")
    log_dir=$(jq -r '.log_dir // empty' "$json_file")
    user=$(jq -r '.user // empty' "$json_file")

    echo "=== Cleaning $game_name ==="
    echo ""

    # Parse options
    clean_user_data=false
    clean_steam_cache=false
    for option in {{options}}; do
        case "$option" in
            --user-data|--all) clean_user_data=true ;;
            --steam-cache) clean_steam_cache=true ;;
            --help|-h)
                echo "Usage: just clean <game> [options]"
                echo ""
                echo "Options:"
                echo "  --user-data    Also remove user data (saves, logs, configs)"
                echo "  --steam-cache  Also remove steam download cache"
                echo "  --all          Clean everything (combines all options)"
                echo ""
                echo "Default: Only stops service, disables auto-start, and removes game installation directory"
                exit 0
                ;;
        esac
    done

    # 1. Stop the service if running
    echo "1. Stopping service..."
    if sudo systemctl is-active --quiet "$unit_name" 2>/dev/null; then
        sudo systemctl stop "$unit_name"
        echo "   ✓ Service stopped"
    else
        echo "   ✓ Service was not running"
    fi

    # 2. Remove game installation directory
    if [[ -n "$game_dir" && "$game_dir" != "null" && -d "$game_dir" ]]; then
        echo "3. Removing game files..."
        echo "   Directory: $game_dir"
        size=$(du -sh "$game_dir" 2>/dev/null | cut -f1 || echo "unknown")
        echo "   Size: $size"
        read -p "   Remove game installation directory? [y/N] " -n 1 -r
        echo ""
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            sudo rm -rf "$game_dir"
            echo "   ✓ Game files removed"
        else
            echo "   ✓ Game files kept"
        fi
    else
        echo "3. Game directory not found or not specified"
    fi

    # 4. Clean user data if requested
    if [[ "$clean_user_data" == "true" && -n "$user" && "$user" != "null" ]]; then
        user_home=$(getent passwd "$user" | cut -d: -f6)
        if [[ -n "$user_home" && -d "$user_home" ]]; then
            echo "4. Cleaning user data..."
            echo "   User home: $user_home"

            # Show what would be removed
            echo "   Files that would be removed:"
            if [[ -n "$log_dir" && "$log_dir" != "null" && -d "$log_dir" ]]; then
                echo "     - Logs: $log_dir"
            fi
            find "$user_home" -maxdepth 2 -type d -name "*7DaysToDie*" -o -name "*save*" -o -name "*config*" | sed 's/^/     - /'

            read -p "   Remove user data (saves, logs, configs)? [y/N] " -n 1 -r
            echo ""
            if [[ $REPLY =~ ^[Yy]$ ]]; then
                # Remove logs
                if [[ -n "$log_dir" && "$log_dir" != "null" && -d "$log_dir" ]]; then
                    rm -rf "$log_dir"
                    echo "     ✓ Logs removed"
                fi
                # Remove game-specific directories in user home
                find "$user_home" -maxdepth 2 -type d -name "*7DaysToDie*" -exec rm -rf {} \; 2>/dev/null || true
                echo "     ✓ User data cleaned"
            else
                echo "     ✓ User data kept"
            fi
        fi
    elif [[ "$clean_user_data" == "true" ]]; then
        echo "3. No user specified for user data cleanup"
    fi

    # 4. Clean steam cache if requested
    if [[ "$clean_steam_cache" == "true" && -n "$steam_app" && "$steam_app" != "null" ]]; then
        echo "4. Cleaning steam cache..."
        steam_cache_dir="/opt/steam/steamapps/downloading/${steam_app}"
        if [[ -d "$steam_cache_dir" ]]; then
            echo "   Cache directory: $steam_cache_dir"
            size=$(du -sh "$steam_cache_dir" 2>/dev/null | cut -f1 || echo "unknown")
            echo "   Size: $size"
            read -p "   Remove steam download cache? [y/N] " -n 1 -r
            echo ""
            if [[ $REPLY =~ ^[Yy]$ ]]; then
                rm -rf "$steam_cache_dir"
                echo "   ✓ Steam cache removed"
            else
                echo "   ✓ Steam cache kept"
            fi
        else
            echo "   ✓ No steam cache found"
        fi

        # Also stop the steam download service
        if sudo systemctl is-active --quiet "steam@${steam_app}.service" 2>/dev/null; then
            sudo systemctl stop "steam@${steam_app}.service"
            echo "   ✓ Steam download service stopped"
        fi
    elif [[ "$clean_steam_cache" == "true" ]]; then
        echo "4. No steam app specified for cache cleanup"
    fi

    echo ""
    echo "=== Cleanup Complete ==="
    echo "Game service '$game_name' has been cleaned."
    echo ""
    echo "To completely reinstall:"
    echo "  just update {{game}}  # Download fresh game files"
    echo "  just start {{game}}   # Start the service"

# Show disk usage for game files
disk:
    #!/usr/bin/env bash
    echo "=== Game Files Disk Usage ==="
    echo ""

    total_size=0
    if [[ -d /etc/gameserver/services ]]; then
        for json_file in /etc/gameserver/services/*.json; do
            if [[ -f "$json_file" ]]; then
                game_id=$(jq -r '.id' "$json_file")
                game_name=$(jq -r '.name' "$json_file")
                game_dir=$(jq -r '.game_dir // empty' "$json_file")

                if [[ -n "$game_dir" && "$game_dir" != "null" && -d "$game_dir" ]]; then
                    echo "$game_name ($game_id):"
                    size_mb=$(du -sm "$game_dir" | cut -f1)
                    echo "  Directory: $game_dir"
                    echo "  Size: $(du -sh "$game_dir" | cut -f1)"
                    echo ""
                    echo "  Largest files:"
                    find "$game_dir" -type f -size +50M -exec du -h {} \; 2>/dev/null | sort -hr | head -3 | sed 's/^/    /' || echo "    (no large files found)"
                    echo ""
                    total_size=$((total_size + size_mb))
                else
                    echo "$game_name ($game_id): Directory not found ($game_dir)"
                    echo ""
                fi
            fi
        done

        if [[ $total_size -gt 0 ]]; then
            echo "Total game files: ${total_size}M"
        fi
    else
        echo "No games configured."
    fi

    echo ""
    echo "Steam cache usage:"
    if [[ -d /opt/steam ]]; then
        du -sh /opt/steam
    else
        echo "Steam directory not found"
    fi

# Interactive service management
manage:
    #!/usr/bin/env bash
    while true; do
        clear
        echo "=== Game Server Management ==="
        just status
        echo ""
        read -p "Enter command (or 'quit' to exit): " cmd
        case "$cmd" in
            quit|q|exit) break ;;
            "") continue ;;
            *)
                if command -v just >/dev/null && just --list | grep -q "^  ${cmd%% *}"; then
                    just $cmd || read -p "Press Enter to continue..."
                else
                    echo "Unknown command: $cmd"
                    read -p "Press Enter to continue..."
                fi
                ;;
        esac
    done
